# Local development: SQLite and verification emails printed in the server terminal.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=development-only-change-this-key-before-deploying
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DB_ENGINE=sqlite

# Exact frontend origins, including protocol and port. Do not add trailing slashes.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:5173
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Student News <noreply@example.com>

# Gmail setup: python scripts/configure_gmail.py (see docs/gmail-setup.md).
# Enable Google 2-Step Verification and create a 16-character App Password.
# Never use your normal Google password; keep SMTP secrets in .env, not frontend code.
# The script checks STARTTLS authentication before changing the existing .env.
# Real Gmail SMTP: uncomment these settings and replace both account/password placeholders.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-account@gmail.com
# EMAIL_HOST_PASSWORD=your-16-character-app-password
# EMAIL_USE_TLS=true
# EMAIL_USE_SSL=false
# DEFAULT_FROM_EMAIL='Student News <your-account@gmail.com>'

# PostgreSQL: create the database and user first, then set DB_ENGINE=postgresql.
# DB_ENGINE=postgresql
# POSTGRES_DB=student_news
# POSTGRES_USER=student_news
# POSTGRES_PASSWORD=replace-this
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_SSLMODE=prefer

# Production additionally requires:
# DJANGO_DEBUG=false
# DJANGO_SECRET_KEY=<a-random-secret-of-at-least-50-characters>
# DJANGO_ALLOWED_HOSTS=api.your-domain.mn
# CORS_ALLOWED_ORIGINS=https://app.your-domain.mn
# CSRF_TRUSTED_ORIGINS=https://app.your-domain.mn
# COOKIE_SECURE=true
# PostgreSQL, real SMTP, and HTTPS.

# Copy to .env. Defaults let every teammate run locally without credentials.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DB_ENGINE=sqlite
SQLITE_NAME=db.sqlite3

# For MySQL, install requirements-mysql.txt and set DB_ENGINE=mysql.
DB_NAME=student_hub
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Console prints verification emails to the backend terminal during development.
# For real email delivery, change to django.core.mail.backends.smtp.EmailBackend
# and enter your SMTP provider credentials below.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Student Hub <noreply@example.com>

# Use a fixed Flutter web port, e.g. flutter run -d chrome --web-port=3000.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=

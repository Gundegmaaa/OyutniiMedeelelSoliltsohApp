{
  "info": {
    "_postman_id": "ef72e964-a606-48fc-88ec-c1e8a3af8a8b",
    "name": "Student Hub — email authentication",
    "description": "Local Django API integration tests. Import the companion environment and send requests in numbered order. Read email OTPs from the backend terminal (console email backend) and enter registration_code/login_code before the corresponding verify requests. All requests target base_url only; API tokens are captured into the active environment. Restart with 01 Health to generate a fresh test email.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.info.requestName === \"01 Health\") {",
          "  pm.environment.set(\"email\", \"postman-\" + Date.now() + \"@example.com\");",
          "  [",
          "    \"registration_code\", \"login_code\", \"wrong_registration_code\",",
          "    \"register_challenge_id\", \"login_challenge_id\", \"register_session_token\",",
          "    \"session_token\", \"second_session_token\", \"device_token\", \"device_id\", \"user_id\"",
          "  ].forEach(function (key) { pm.environment.set(key, \"\"); });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 Health",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/health/",
        "description": "Эхний хүсэлт. Шинэ туршилтын мэйл үүсгэж, өмнөх run-ийн код/token утгуудыг цэвэрлэнэ.",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "const data = pm.response.json();",
              "pm.test(\"Backend is healthy\", function () { pm.expect(data.status).to.equal(\"ok\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Register",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/auth/register/",
        "description": "Send дараа backend terminal дахь бүртгэлийн зургаан оронтой кодыг environment-ийн registration_code утгад оруулна.",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"full_name\": \"{{full_name}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 202\", function () { pm.response.to.have.status(202); });",
              "const data = pm.response.json();",
              "pm.test(\"Registration needs email verification\", function () {",
              "  pm.expect(data.verification_required).to.equal(true);",
              "  pm.expect(data.purpose).to.equal(\"register\");",
              "  pm.expect(data.challenge_id).to.be.a(\"string\").and.not.empty;",
              "  pm.expect(data.expires_in).to.be.above(0);",
              "  pm.expect(data.resend_after).to.be.above(0);",
              "});",
              "pm.test(\"No session or email code is returned\", function () {",
              "  pm.expect(data).not.to.have.property(\"token\");",
              "  pm.expect(data).not.to.have.property(\"code\");",
              "  pm.expect(data).not.to.have.property(\"otp\");",
              "});",
              "pm.test(\"Authentication response is not cached\", function () { pm.expect(pm.response.headers.get(\"Cache-Control\")).to.equal(\"no-store\"); });",
              "if (pm.response.code === 202) pm.environment.set(\"register_challenge_id\", data.challenge_id);"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Resend cooldown",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/auth/resend-code/",
        "description": "02 Register-ийн дараа 60 секундийн дотор явуулна.",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"challenge_id\": \"{{register_challenge_id}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 429\", function () { pm.response.to.have.status(429); });",
              "const data = pm.response.json();",
              "pm.test(\"Immediate resend is rate limited\", function () {",
              "  pm.expect(data.error).to.equal(\"resend_too_soon\");",
              "  pm.expect(data.retry_after).to.be.above(0);",
              "  pm.expect(Number(pm.response.headers.get(\"Retry-After\"))).to.be.above(0);",
              "});",
              "pm.test(\"No session or email code is returned\", function () {",
              "  pm.expect(data).not.to.have.property(\"token\");",
              "  pm.expect(data).not.to.have.property(\"code\");",
              "  pm.expect(data).not.to.have.property(\"otp\");",
              "});",
              "pm.test(\"Authentication response is not cached\", function () { pm.expect(pm.response.headers.get(\"Cache-Control\")).to.equal(\"no-store\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Wrong registration code",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/auth/register/verify/",
        "description": "registration_code-оос ялгаатай код автоматаар сонгоно; эхлээд бодит кодоо environment-д оруулсан байна.",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"challenge_id\": \"{{register_challenge_id}}\",\n  \"code\": \"{{wrong_registration_code}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const code = String(pm.environment.get(\"registration_code\") || \"\");",
              "if (!/^[0-9]{6}$/.test(code)) {",
              "  throw new Error(\"Copy the six-digit email code from the backend terminal into the registration_code environment variable, then send again.\");",
              "}",
              "pm.environment.set(\"wrong_registration_code\", code === \"000000\" ? \"111111\" : \"000000\");"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", function () { pm.response.to.have.status(400); });",
              "const data = pm.response.json();",
              "pm.test(\"Incorrect code is rejected\", function () { pm.expect(data.error).to.equal(\"invalid_code\"); });",
              "pm.test(\"No session or email code is returned\", function () {",
              "  pm.expect(data).not.to.have.property(\"token\");",
              "  pm.expect(data).not.to.have.property(\"code\");",
              "  pm.expect(data).not.to.have.property(\"otp\");",
              "});",
              "pm.test(\"Authentication response is not cached\", function () { pm.expect(pm.response.headers.get(\"Cache-Control\")).to.equal(\"no-store\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Register verify",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/auth/register/verify/",
        "description": "Бүртгэлийн terminal/email OTP-г registration_code утгад оруулж 10 минутын дотор батална.",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"challenge_id\": \"{{register_challenge_id}}\",\n  \"code\": \"{{registration_code}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const code = String(pm.environment.get(\"registration_code\") || \"\");",
              "if (!/^[0-9]{6}$/.test(code)) {",
              "  throw new Error(\"Copy the six-digit email code from the backend terminal into the registration_code environment variable, then send again.\");",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "const data = pm.response.json();",
              "pm.test(\"Verified user receives a Bearer session\", function () {",
              "  pm.expect(data.token).to.be.a(\"string\").and.not.empty;",
              "  pm.expect(data.token_type).to.equal(\"Bearer\");",
              "  pm.expect(data.expires_in).to.be.above(0);",
              "  pm.expect(data.user.email).to.equal(pm.environment.get(\"email\"));",
              "  pm.expect(data.user.email_verified).to.equal(true);",
              "  pm.expect(data.user).not.to.have.property(\"password\");",
              "});",
              "pm.test(\"Authentication response is not cached\", function () { pm.expect(pm.response.headers.get(\"Cache-Control\")).to.equal(\"no-store\"); });",
              "if (pm.response.code === 200) {",
              "  pm.environment.set(\"register_session_token\", data.token);",
              "  pm.environment.set(\"session_token\", data.token);",
              "  pm.environment.set(\"user_id\", String(data.user.id));",
              "}"
            ]
          }
        }
      ]
    },
    {

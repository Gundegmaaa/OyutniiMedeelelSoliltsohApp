            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "const data = pm.response.json();",
              "pm.test(\"Remembered device metadata is listed without its secret\", function () {",
              "  pm.expect(data).to.be.an(\"array\");",
              "  const device = data.find(function (entry) { return entry.id === pm.environment.get(\"device_id\"); });",
              "  pm.expect(device).to.be.an(\"object\");",
              "  pm.expect(device.name).to.equal(\"Postman test device\");",
              "  pm.expect(device).not.to.have.property(\"token_hash\");",
              "  pm.expect(device).not.to.have.property(\"device_token\");",
              "  pm.expect(pm.response.text()).not.to.include(pm.environment.get(\"device_token\"));",
              "});",
              "pm.test(\"Authentication response is not cached\", function () { pm.expect(pm.response.headers.get(\"Cache-Control\")).to.equal(\"no-store\"); });"
            ]
          }
        }
      ]
    },

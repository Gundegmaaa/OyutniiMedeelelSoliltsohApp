    },
    {
      "name": "13 Revoked second session",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/auth/me/",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{second_session_token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\", function () { pm.response.to.have.status(401); });",
              "const data = pm.response.json();",
              "pm.test(\"Forgetting a device revokes its other sessions\", function () {",
              "  pm.expect(data.error).to.equal(\"authentication_failed\");",
              "  pm.expect(data).not.to.have.property(\"email\");",
              "});",
              "pm.test(\"Authentication response is not cached\", function () { pm.expect(pm.response.headers.get(\"Cache-Control\")).to.equal(\"no-store\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "14 Unauthenticated me",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/auth/me/",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\", function () { pm.response.to.have.status(401); });",
              "const data = pm.response.json();",
              "pm.test(\"Private user information needs a Bearer token\", function () {",
              "  pm.expect(data.error).to.equal(\"not_authenticated\");",
              "  pm.expect(data).not.to.have.property(\"email\");",
              "});",
              "pm.test(\"Authentication response is not cached\", function () { pm.expect(pm.response.headers.get(\"Cache-Control\")).to.equal(\"no-store\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "15 Invalid password",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/auth/login/",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"WrongPassword!123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\", function () { pm.response.to.have.status(401); });",
              "const data = pm.response.json();",
              "pm.test(\"Wrong password cannot start email verification\", function () { pm.expect(data.error).to.equal(\"invalid_credentials\"); });",
              "pm.test(\"No session or email code is returned\", function () {",
              "  pm.expect(data).not.to.have.property(\"token\");",
              "  pm.expect(data).not.to.have.property(\"code\");",
              "  pm.expect(data).not.to.have.property(\"otp\");",
              "});",
              "pm.test(\"Authentication response is not cached\", function () { pm.expect(pm.response.headers.get(\"Cache-Control\")).to.equal(\"no-store\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "16 Logout registration session",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/auth/logout/",
        "description": "Энэ run-ийн бүртгүүлэх үед авсан тусдаа session-ийг хаана.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{register_session_token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"forget_device\": false\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 204\", function () { pm.response.to.have.status(204); });",
              "pm.test(\"Authentication response is not cached\", function () { pm.expect(pm.response.headers.get(\"Cache-Control\")).to.equal(\"no-store\"); });",
              "pm.test(\"Registration session is cleaned up\", function () { pm.expect(pm.response.text()).to.equal(\"\"); });"
            ]
          }
        }
      ]
    }
  ]
